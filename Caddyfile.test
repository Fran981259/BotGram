:80 {
    respond /healthz 200

    reverse_proxy /api/* portal_cerrado:8000
    reverse_proxy /* frontend:3000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://acritica.net https://*.acritica.net https://agorams.com.br https://*.agorams.com.br https://bonitobrazil.com.br https://*.bonitobrazil.com.br https://campograndenews.com.br https://*.campograndenews.com.br https://capitaldopantanal.com.br https://*.capitaldopantanal.com.br https://capitalnews.com.br https://*.capitalnews.com.br https://conesulnews.com.br https://*.conesulnews.com.br https://correiodecorumba.com.br https://*.correiodecorumba.com.br https://correiodetreslagoas.com.br https://*.correiodetreslagoas.com.br https://correiodoestado.com.br https://*.correiodoestado.com.br https://costaricaemfoco.com.br https://*.costaricaemfoco.com.br https://coximagora.com.br https://*.coximagora.com.br https://diariodetreslagoas.com.br https://*.diariodetreslagoas.com.br https://diariodigital.com.br https://*.diariodigital.com.br https://diarionline.com.br https://*.diarionline.com.br https://douradosagora.com.br https://*.douradosagora.com.br https://douradosnews.com.br https://*.douradosnews.com.br https://douranews.com.br https://*.douranews.com.br https://edicaoms.com.br https://*.edicaoms.com.br https://hojemais.com.br https://*.hojemais.com.br https://jd1noticias.com https://*.jd1noticias.com https://jornaldanova.com.br https://*.jornaldanova.com.br https://jornaltribunalivre.com.br https://*.jornaltribunalivre.com.br https://jovemsulnews.com.br https://*.jovemsulnews.com.br https://jpnews.com.br https://*.jpnews.com.br https://maracajunahora.com.br https://*.maracajunahora.com.br https://midiamax.com.br https://*.midiamax.com.br https://msnoticias.com.br https://*.msnoticias.com.br https://mstododia.com.br https://*.mstododia.com.br https://naviraidiario.com.br https://*.naviraidiario.com.br https://oestadoonline.com.br https://*.oestadoonline.com.br https://opantaneiro.com.br https://*.opantaneiro.com.br https://perfilnews.com.br https://*.perfilnews.com.br https://pontaporainforma.com.br https://*.pontaporainforma.com.br https://primeirapagina.com.br https://*.primeirapagina.com.br https://progresso.com.br https://*.progresso.com.br https://rcn67.com.br https://*.rcn67.com.br https://regiaomsnoticias.com.br https://*.regiaomsnoticias.com.br https://reporterms.com.br https://*.reporterms.com.br; connect-src 'self'; frame-src 'self'; media-src 'self'"
    }
}
