{
    email razuk@portalcerrado.com.br
}

portalcerrado.com.br, www.portalcerrado.com.br {
    handle /healthz {
        respond 200
    }

    # Rotas API que pertencem ao Next.js
    handle /api/markets {
        reverse_proxy frontend:3000
    }

    # Demais APIs pertencem ao backend Python
    handle /api/* {
        reverse_proxy portal_cerrado:8000
    }

    # Frontend Next.js
    handle {
        reverse_proxy frontend:3000
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.unsplash.com https://picsum.photos https://*.picsum.photos https://*.midiamax.com.br https://*.campograndenews.com.br https://*.correiodoestado.com.br https://*.capitalnews.com.br; connect-src 'self'; frame-src 'self'; media-src 'self'"
    }
}
